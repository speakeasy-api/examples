{
  "type": "module",
  "name": "speakeasy-fastify-example",
  "description": "A Fastify example for Speakeasy",
  "version": "0.1.0",
  "main": "app.js",
  "scripts": {
    "start": "fastify start -l info app.js",
    "dev": "fastify start -w -l info -P app.js",
    "lint": "standard --fix",
    "openapi": "fastify generate-swagger app.js > openapi.json",
    "sdk": "speakeasy generate sdk --schema openapi.json --lang typescript --out ./sdk"
  },
  "keywords": [],
  "author": "Speakeasy",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/autoload": "^6.3.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.7.0",
    "@scalar/fastify-api-reference": "^1.25.11",
    "fastify": "^5.8.0",
    "fastify-cli": "^8.0",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "standard": "^17.1.0"
  }
}
